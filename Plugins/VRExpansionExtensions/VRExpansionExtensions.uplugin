{
  "FileVersion": 3,
  "Version": 1,
  "VersionName": "1.0",
  "FriendlyName": "VRExpansionExtensions",
  "Description": "Third-party extensions built on top of VRExpansionPlugin.",
  "Category": "VRExpansion",
  "CreatedBy": "Zhang Shunlin",
  "EnabledByDefault": false,
  "CanContainContent": false,
  "IsBetaVersion": false,
  "Installed": false,
  "SupportedTargetPlatforms": [
    "Win64",
    "Linux",
    "Android"
  ],
  "Modules": [
    {
      "Name": "VRExpansionExtensions",
      "Type": "Runtime",
      "LoadingPhase": "Default"
    }
  ],
  "Plugins": [
    {
      "Name": "VRExpansionPlugin",
      "Enabled": true
    },
    {
      "Name": "XRBase",
      "Enabled": true
    },
    {
      "Name": "OpenXR",
      "Enabled": true,
      "PlatformAllowList": [
        "Win64",
        "Linux",
        "Android"
      ]
    }
  ]
}
